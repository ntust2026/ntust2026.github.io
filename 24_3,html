        async function handleChatSubmit(event) {
            if (event) event.preventDefault();

            const chatInput = document.getElementById('chat-input');
            const userText = chatInput.value.trim();
            if (!userText) return;

            // 1. 在 UI 呈現使用者訊息
            appendMessage('user', userText);
            chatInput.value = '';

            // 2. 顯示 AI 正在思考中
            const typingId = appendTypingIndicator();

            // 3. 建構 Payload
            chatHistory.push({ role: "user", parts: [{ text: userText }] });

            const payload = {
                contents: chatHistory,
                systemInstruction: {
                    parts: [{ text: SYSTEM_PROMPT }]
                }
            };

            const url = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-09-2025:generateContent?key=${apiKey}`;

            try {
                const data = await fetchWithRetry(url, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(payload)
                });

                // 4. 移除思考中動畫
                removeTypingIndicator(typingId);

                // 5. 解析回答
                const aiResponse = data.candidates?.[0]?.content?.parts?.[0]?.text;
                if (aiResponse) {
                    appendMessage('ai', aiResponse);
                    chatHistory.push({ role: "model", parts: [{ text: aiResponse }] });
                } else {
                    throw new Error("AI 無法回傳有效的對話內容");
                }
            } catch (err) {
                removeTypingIndicator(typingId);
                appendMessage('ai', `❌ <strong>對話線路繁忙</strong>：${err.message || '連線逾時'}。請稍後再試，或使用左側「推薦問題」獲得即時解答！`);
                showToast("連線異常，請稍後再試！");
            }
        }

        // 快捷提問
        function sendPresetQuestion(text) {
            document.getElementById('chat-input').value = text;
            handleChatSubmit();
        }

        // 清空歷史紀錄
        function clearChatHistory() {
            chatHistory = [];
            const chatMessages = document.getElementById('chat-messages');
            chatMessages.innerHTML = `
                <!-- 歡迎語 -->
                <div class="flex items-start space-x-3 max-w-[85%]">
                    <div class="w-8 h-8 rounded-lg bg-brand-500/10 text-brand-500 flex items-center justify-center shrink-0 border border-brand-500/20">💡</div>
                    <div class="p-3.5 bg-darkCard border border-darkBorder rounded-2xl text-xs sm:text-sm text-gray-200 leading-relaxed">
                        對話歷史已清空。您可以再次向我詢問關於 LM Studio、Notion、Anki、VBA、Premiere Proxy 代理檔等任何 NotebookLM 工具的核心玩法！
                    </div>
                </div>
            `;
            showToast("歷史紀錄已重置。");
        }

        // 將訊息附加至聊天視窗
        function appendMessage(role, text) {
            const container = document.getElementById('chat-messages');
            const msgDiv = document.createElement('div');
            
            if (role === 'user') {
                msgDiv.className = "flex items-start space-x-3 justify-end max-w-[90%] ml-auto";
                msgDiv.innerHTML = `
                    <div class="p-3 bg-brand-500 text-white rounded-2xl text-xs sm:text-sm leading-relaxed shadow-md">
                        ${text}
                    </div>
                    <div class="w-8 h-8 rounded-lg bg-brand-600 text-white flex items-center justify-center shrink-0 border border-brand-500 font-extrabold text-xs">我</div>
                `;
            } else {
                msgDiv.className = "flex items-start space-x-3 max-w-[85%]";
                msgDiv.innerHTML = `
                    <div class="w-8 h-8 rounded-lg bg-brand-500/10 text-brand-500 flex items-center justify-center shrink-0 border border-brand-500/20">💡</div>
                    <div class="p-3.5 bg-darkCard border border-darkBorder rounded-2xl text-xs sm:text-sm text-gray-200 leading-relaxed space-y-2">
                        ${formatMarkdown(text)}
                    </div>
                `;
            }

            container.appendChild(msgDiv);
            container.scrollTop = container.scrollHeight;
        }

        // 附加思考中動畫
        function appendTypingIndicator() {
            const container = document.getElementById('chat-messages');
            const typingDiv = document.createElement('div');
            const id = 'typing-' + Date.now();
            typingDiv.id = id;
            typingDiv.className = "flex items-start space-x-3 max-w-[85%]";
            typingDiv.innerHTML = `
                <div class="w-8 h-8 rounded-lg bg-brand-500/10 text-brand-500 flex items-center justify-center shrink-0 border border-brand-500/20">💡</div>
                <div class="p-3.5 bg-darkCard border border-darkBorder rounded-2xl text-xs sm:text-sm text-gray-400 flex items-center space-x-1">
                    <span class="font-medium">導師正在查閱講義中</span>
                    <span class="w-1.5 h-1.5 bg-brand-500 rounded-full animate-bounce"></span>
                    <span class="w-1.5 h-1.5 bg-brand-500 rounded-full animate-bounce [animation-delay:0.2s]"></span>
                    <span class="w-1.5 h-1.5 bg-brand-500 rounded-full animate-bounce [animation-delay:0.4s]"></span>
                </div>
            `;
            container.appendChild(typingDiv);
            container.scrollTop = container.scrollHeight;
            return id;
        }

        function removeTypingIndicator(id) {
            const el = document.getElementById(id);
            if (el) el.remove();
        }

        // 簡單 Markdown 格式轉化 (粗體、段落換行、斜體、程式碼區塊)
        function formatMarkdown(text) {
            let formatted = text
                .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
                .replace(/\*(.*?)\*/g, '<em>$1</em>')
                .replace(/`([^`]+)`/g, '<code class="bg-darkBg border border-darkBorder px-1 py-0.5 rounded text-xs text-brand-400">$1</code>')
                .replace(/\n/g, '<br>');
            return formatted;
        }
    </script>
</body>
