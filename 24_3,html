        // --- Python 變數命名合法性檢查器 (入門 #02 核心點) ---
        function checkPythonVariable(val) {
            const feedback = document.getElementById('python-var-feedback');
            const textSpan = document.getElementById('python-feedback-text');

            if (!val || val.trim() === '') {
                feedback.className = "p-3 bg-darkBg rounded-xl border border-darkBorder flex items-start space-x-2 text-xs text-gray-400";
                textSpan.innerHTML = "請輸入變數名稱進行規則驗證";
                return;
            }

            // Python 保留字
            const keywords = ['False', 'None', 'True', 'and', 'as', 'assert', 'async', 'await', 'break', 'class', 'continue', 'def', 'del', 'elif', 'else', 'except', 'finally', 'for', 'from', 'global', 'if', 'import', 'in', 'is', 'lambda', 'nonlocal', 'not', 'or', 'pass', 'raise', 'return', 'try', 'while', 'with', 'yield'];

            const trimmed = val.trim();

            // 1. 檢查是否為保留字
            if (keywords.includes(trimmed)) {
                feedback.className = "p-3 bg-red-500/10 rounded-xl border border-red-500/30 flex items-start space-x-2 text-xs text-red-400";
                textSpan.innerHTML = `⚠️ 錯誤！"<strong>${trimmed}</strong>" 是 Python 的系統保留字 (Keywords)，無法做為變數命名。`;
                return;
            }

            // 2. 檢查首字元是否為數字
            if (/^[0-9]/.test(trimmed)) {
                feedback.className = "p-3 bg-red-500/10 rounded-xl border border-red-500/30 flex items-start space-x-2 text-xs text-red-400";
                textSpan.innerHTML = `⚠️ 錯誤！Python 變數<strong>不能以數字開頭</strong>。請修改字首。`;
                return;
            }

            // 3. 檢查空格或特殊字元
            if (/\s/.test(trimmed)) {
                feedback.className = "p-3 bg-red-500/10 rounded-xl border border-red-500/30 flex items-start space-x-2 text-xs text-red-400";
                textSpan.innerHTML = `⚠️ 錯誤！變數名稱<strong>不能包含空格</strong>。推薦使用底線 "<strong>_</strong>" 代替空格。`;
                return;
            }

            if (!/^[a-zA-Z0-9_]+$/.test(trimmed)) {
                feedback.className = "p-3 bg-red-500/10 rounded-xl border border-red-500/30 flex items-start space-x-2 text-xs text-red-400";
                textSpan.innerHTML = `⚠️ 錯誤！名稱只能包含英文字母、數字以及底線，<strong>不能含有符號或中文字元</strong>。`;
                return;
            }

            // 完全合法
            feedback.className = "p-3 bg-green-500/10 rounded-xl border border-green-500/30 flex items-start space-x-2 text-xs text-green-400";
            textSpan.innerHTML = `🎉 恭喜！"<strong>${trimmed}</strong>" 是完全合法的 Python 變數。可完美編譯運行！`;
        }

